# Required for Vercel deployment - Convex backend connection URL
# Get this from your Convex dashboard or .env.local
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: Vly monitoring (for error reporting)
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# Convex backend (server-side, not needed in Vercel)
CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=
